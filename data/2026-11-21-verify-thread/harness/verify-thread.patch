+// CPUs this process may run on: taskset and container cpusets count here, hardware_concurrency() ignores them
+unsigned usable_cpus() {
+    cpu_set_t allowed;
+    CPU_ZERO(&allowed);
+    if (::sched_getaffinity(0, sizeof(allowed), &allowed) != 0) { return 1; }
+    return static_cast<unsigned>(CPU_COUNT(&allowed));
+}
+
+// verify on a second thread when there is a CPU for it; EMBR_VERIFY=inline|thread forces either
+bool verify_on_thread() {
+    const char* mode = std::getenv("EMBR_VERIFY");
+    if (mode != nullptr && std::string_view{mode} == "inline") { return false; }
+    if (mode != nullptr && std::string_view{mode} == "thread") { return true; }
+    return usable_cpus() >= 2;
+}
+
+// Hashes received chunks off the receiving thread: without SHA extensions one chunk's hash takes
+// about as long as receiving it, and nothing is read from the socket while it runs inline.
+class ChunkVerifier {
+public:
+    struct Result {
+        uint32_t chunk_index;
+        bool matches;
+    };
+
+    ChunkVerifier(int fd, const FileMeta& meta, bool threaded) : fd_(fd), meta_(meta) {
+        if (threaded) { worker_ = std::thread([this] { run(); }); }
+    }
+    ~ChunkVerifier() { stop(); }
+    ChunkVerifier(const ChunkVerifier&) = delete;
+    ChunkVerifier& operator=(const ChunkVerifier&) = delete;
+
+    // the chunk is complete on disk; verified now when there is no thread
+    void submit(uint32_t chunk_index) {
+        if (!worker_.joinable()) {
+            finished_.push_back(verify(chunk_index));
+            return;
+        }
+        {
+            std::lock_guard lock(mutex_);
+            pending_.push_back(chunk_index);
+        }
+        wake_.notify_one();
+    }
+
+    // results ready so far; never waits
+    std::vector<Result> take_finished() {
+        std::lock_guard lock(mutex_);
+        return std::exchange(finished_, {});
+    }
+
+    // waits until every submitted chunk is verified
+    std::vector<Result> finish() {
+        stop();
+        return std::exchange(finished_, {});
+    }
+
+    // an error on the verifier thread (a failed mmap) surfaces on the receiving thread here
+    void rethrow_if_failed() {
+        std::lock_guard lock(mutex_);
+        if (error_) { std::rethrow_exception(error_); }
+    }
+
+private:
+    Result verify(uint32_t chunk_index) const {
+        const auto [offset, len] = chunk_span(meta_, chunk_index);
+        return {chunk_index,
+                chunk_on_disk_matches(fd_, chunk_index, offset, len, meta_.chunk_hashes[chunk_index])};
+    }
+
+    void run() {
+        std::unique_lock lock(mutex_);
+        for (;;) {
+            wake_.wait(lock, [this] { return closing_ || !pending_.empty(); });
+            if (pending_.empty()) { return; } // closing, and nothing left to verify
+            const uint32_t chunk_index = pending_.front();
+            pending_.pop_front();
+            lock.unlock();
+            Result result{chunk_index, false};
+            std::exception_ptr error;
+            try {
+                result = verify(chunk_index);
+            } catch (...) {
+                error = std::current_exception();
+            }
+            lock.lock();
+            if (error) {
+                error_ = error;
+                return;
+            }
+            finished_.push_back(result);
+        }
+    }
+
+    void stop() {
+        if (!worker_.joinable()) { return; }
+        {
+            std::lock_guard lock(mutex_);
+            closing_ = true;
+        }
+        wake_.notify_one();
+        worker_.join();
+    }
+
+    int fd_;
+    const FileMeta& meta_;
+    std::mutex mutex_;
+    std::condition_variable wake_;
+    std::deque<uint32_t> pending_;
+    std::vector<Result> finished_;
+    std::exception_ptr error_;
+    bool closing_ = false;
+    std::thread worker_;
+};
