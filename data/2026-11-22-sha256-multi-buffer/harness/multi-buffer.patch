+    if (sha256_lanes() > 1 && inputs.size() * 2 >= sha256_lanes() && fits) {
+        sha256_side_by_side(inputs, digests);
+        return;
+    }
+#endif
+    for (size_t i = 0; i < inputs.size(); ++i) {
+        digests[i] = sha256_buf(inputs[i].data, inputs[i].len);
+    }
+}
