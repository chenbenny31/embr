+void sha256_many(std::span<const HashInput> inputs,
+                 std::span<std::array<uint8_t, HASH_SIZE>> digests) {
+    if (inputs.size() != digests.size()) {
+        throw std::runtime_error("sha256_many: inputs and digests differ in count");
