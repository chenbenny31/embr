+unsigned sha256_lanes() {
+    static const unsigned lanes = [] {
+        unsigned detected = 1;
+#ifdef EMBR_HAVE_ISAL_CRYPTO
+        detected = isal_lanes();
+        if (const char* forced = std::getenv("EMBR_HASH_LANES")) {
